import pandas as pd
import requests

URL = "https://services9.arcgis.com/Gh9awoU677aKree0/arcgis/rest/services/Florida_Statewide_Cadastral/FeatureServer/0/query"

def download_county_incremental(county_code):
    all_rows = []
    last_oid = 0
    while True:
        where = f"CO_NO = '{county_code}' AND OBJECTID > {last_oid}"
        params = {
            "where": where,
            "outFields": "*",
            "f": "json",
            "resultRecordCount": 2000,
            "returnGeometry": "false",
            "orderByFields": "OBJECTID"
        }
        resp = requests.get(URL, params=params, timeout=60)
        data = resp.json()
        features = data.get("features", [])
        if not features:
            break
        for feat in features:
            all_rows.append(feat["attributes"])

        last_oid = features[-1]["attributes"]["OBJECTID"]

        print(f"Fetched {len(features)} rows, last OBJECTID {last_oid}")
        if len(features) < 2000 or not data.get("exceededTransferLimit", False):
            break
    return pd.DataFrame(all_rows)

def main():

    df = download_county_incremental("23")  # Miami‑Dade

    # Prefer PARCEL_ID, fallback to PARCEL_ID_
    if "PARCEL_ID" not in df.columns:
        df["PARCEL_ID"] = None
    if "PARCEL_ID_" not in df.columns:
        df["PARCEL_ID_"] = None
    df["parcel_id"] = df["PARCEL_ID"].fillna(df["PARCEL_ID_"]).astype(str).str.strip()

    # Address construction (safe string coercion)
    for col in ["PHY_ADDR1", "PHY_ADDR2", "PHY_CITY", "PHY_ZIPCD"]:
        if col not in df.columns:
            df[col] = ""
    addr_part = (
        df[["PHY_ADDR1", "PHY_ADDR2"]]
        .fillna("")
        .astype(str)
        .agg(" ".join, axis=1)
        .str.replace(r"\s+", " ", regex=True)
        .str.strip()
    )
    city = df["PHY_CITY"].fillna("").astype(str).str.strip()
    zipc = df["PHY_ZIPCD"].fillna("").astype(str).str.strip()
    df["situs_address"] = (addr_part + ", " + city + " " + zipc).str.replace(" ,", ",").str.strip()

    # Rename fields
    rename_map = {
        "CO_NO": "county_code",
        "ACT_YR_BLT": "year_built",
        "DOR_UC": "property_use",
        "LND_SQFOOT": "lot_size",
        "TOT_LVG_AR": "building_area",
        "LND_VAL": "land_value",
        "JV": "just_value",
    }
    for k in list(rename_map.keys()):
        if k not in df.columns:
            df[k] = None
    df_final = df.rename(columns=rename_map)[
        ["parcel_id", "situs_address", "year_built", "county_code", "property_use", "lot_size", "building_area", "land_value", "just_value"]
    ]

    # Save CSV
    out_name = "miamidade_parcels.csv"
    df_final.to_csv(out_name, index=False)
    print(f"\nSaved: {out_name}")
    print(f"Total rows: {len(df_final)}")


if __name__ == "__main__":
    main()
