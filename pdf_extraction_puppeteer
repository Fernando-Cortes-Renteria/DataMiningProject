const puppeteer = require('puppeteer');

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

(async () => {
    const browser = await puppeteer.launch({
        headless: false,
        defaultViewport: null,
        args: ['--start-maximized']
    });

    const page = await browser.newPage();

    await page.goto('https://web.bcpa.net/BcpaClient/#/Record-Search', { waitUntil: 'networkidle2' });

    await page.waitForSelector('#txtField', { visible: true });
    await page.type('#txtField', 'fl');

    await page.waitForSelector('#searchButton', { visible: true });
    await page.evaluate(() => {
        document.querySelector('#searchButton').click();
    });

    await page.waitForSelector("#tbl-list-parcels > tbody > tr:nth-child(1) > td:nth-child(1) > div > a", { visible: true });
    await page.evaluate(() => {
        document.querySelector("#tbl-list-parcels > tbody > tr:nth-child(1) > td:nth-child(1) > div > a").click();
    });

    await page.waitForSelector("#hideRecInfoTab", { visible: true });
    await delay(2000); // reemplaza page.waitForTimeout

    // Generar PDF
    await page.pdf({
        path: 'propiedad.pdf',
        format: 'A4',
        printBackground: true
    });

    console.log('PDF generado correctamente: propiedad.pdf');
    await browser.close();
})();
